# Server-side configuration (never expose to the client)
# Provider API credentials / endpoints will be added here as real integrations land.
PROVIDER_API_KEY=
PROVIDER_ENDPOINT=

# Public app URL (used for metadata, links, OAuth redirect URIs, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional local storage overrides (defaults shown)
VIDEOVAULT_DATA_DIR=./data
VIDEOVAULT_DOWNLOAD_DIR=./data/downloads

# Optional: richer YouTube metadata (YouTube Data API v3 key). Without it, oEmbed is used.
YOUTUBE_API_KEY=

# OAuth scaffolding (not enabled yet). Required only if you implement own-content flows.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
VIMEO_ACCESS_TOKEN=

# Optional: Twitch Helix metadata (free Client ID from https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
